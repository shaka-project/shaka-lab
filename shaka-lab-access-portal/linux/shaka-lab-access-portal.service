# Shaka Lab Access Portal service definition for systemd.

[Unit]
Description=Shaka Lab Access Portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=shaka-lab-access-portal
WorkingDirectory=/opt/shaka-lab/shaka-lab-access-portal
# matter-power-control runs chip-tool, which is a snap.
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin
ExecStart=/usr/bin/node dist/server.js --config /etc/shaka-lab-access-portal-config.yaml
Restart=always
# Wait between restarts, so that a bad config doesn't hit systemd's start rate
# limit and leave the service stopped after it's fixed.
RestartSec=10

[Install]
WantedBy=multi-user.target
