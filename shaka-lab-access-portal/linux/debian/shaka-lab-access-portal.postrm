# Post-remove script.  Runs as root after package removal.

# DON'T fail on error.  Always keep going!
set +e

action="$1"

if [[ "$action" == "remove" || "$action" == "purge" ]]; then
  # The service user only needs a systemd instance while the service exists.
  loginctl disable-linger shaka-lab-access-portal 2>/dev/null
fi

if [[ "$action" == "purge" ]]; then
  # The service user's home holds Matter device pairings, which can only be
  # recreated by setting up each device again.  Keep it unless purging.
  rm -rf /opt/shaka-lab/shaka-lab-access-portal
  rm -rf /home/shaka-lab-access-portal
fi
