# Makefile to build the debian package.

# Debug the debian build process.
export DH_VERBOSE = 1

# Defines Make variable DEB_SOURCE for us, which is the name of the package.
include /usr/share/dpkg/pkg-info.mk

# Where we will install things.
export PREFIX = $(PWD)/debian/$(DEB_SOURCE)
export DESTDIR = $(PREFIX)/opt/shaka-lab

# How "dh" helpers will install the package contents to a staging area.
override_dh_auto_install:
	install -m 755 -d "$(PREFIX)/etc/shaka-lab-github-runner.env.d"
	install -m 755 -d "$(PREFIX)/etc/shaka-lab-github-runner.args.d"
	install -m 755 -d "$(PREFIX)/opt/shaka-lab/shaka-lab-github-runner"
	install -m 755 start-runner.sh "$(PREFIX)/opt/shaka-lab/shaka-lab-github-runner/"
	
	# Install the service to /usr/lib, not /etc, so debian does not see it as a
	# "config file" that survives uninstallation.  Don't symlink it into /etc:
	# newer systemd no longer searches /lib, so a symlink pointing there looks
	# like a "linked" unit, which systemctl refuses to enable.
	install -m 755 -d "$(PREFIX)/usr/lib/systemd/system"
	install -m 644 shaka-lab-github-runner@.service "$(PREFIX)/usr/lib/systemd/system/"
	
	# Install a script to clean up Docker images so it doesn't fill up the disk.
	install -m 755 -d "$(PREFIX)/etc/cron.daily"
	install -m 755 docker-cleanup "$(PREFIX)/etc/cron.daily/"
	
	# Install a certbot deploy hook to make certs readable by the runners.
	# This is harmless if certbot is not installed.
	install -m 755 -d "$(PREFIX)/etc/letsencrypt/renewal-hooks/deploy"
	install -m 755 letsencrypt-deploy-hook.sh "$(PREFIX)/etc/letsencrypt/renewal-hooks/deploy/shaka-lab-github-runner.sh"

# Generically, any build target should be handled off to "dh" to do something
# standard, unless a step is overriden above.
%:
	dh $@
