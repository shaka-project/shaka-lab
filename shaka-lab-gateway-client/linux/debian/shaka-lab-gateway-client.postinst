# Post-install script.  Runs as root after package installation.
# It joins this machine to the domain, then configures sssd so that lab users
# can log in, with a password or over SSH with Kerberos.

# Fail on error
set -e

# Source the debconf library, which gives us functions to prompt the user.
. /usr/share/debconf/confmodule


### KERBEROS SETUP ###

backup_config() {
  # If we don't already have an original backup from the first install, make
  # one now.  Subsequent installs or updates will not recreate this.
  if [ -e "$1" ] && [ ! -e "$1".shaka-lab.orig ]; then
    cp -a "$1" "$1".shaka-lab.orig
  fi
}

# Point Kerberos at the gateway, which is the KDC for the lab's realm.
backup_config /etc/krb5.conf

cat <<EOF >/etc/krb5.conf
# /etc/krb5.conf
# Kerberos configuration file, written by shaka-lab-gateway-client.
# See krb5.conf(5) for details.

[libdefaults]
	default_realm = LAB.SHAKA
	dns_lookup_realm = false
	dns_lookup_kdc = false
	# Don't use reverse DNS to find the names of servers.  The lab's reverse
	# zone can have several names for one IP, and the first one returned is
	# often not the one that has keys in Active Directory.
	rdns = false

[realms]
	LAB.SHAKA = {
		kdc = gateway.lab.shaka
		admin_server = gateway.lab.shaka
	}

[domain_realm]
	.lab.shaka = LAB.SHAKA
	lab.shaka = LAB.SHAKA
EOF


### JOINING THE DOMAIN ###

# Joining creates a computer account for this machine on the gateway, and
# writes this machine's keys to /etc/krb5.keytab.  sssd uses those keys to look
# up lab users, and sshd uses them to accept Kerberos logins.  The gateway's
# DNS only knows this machine by its short name in the lab.shaka domain, so
# build the full name from that, rather than trusting the local machine's idea
# of its domain.
short_name=$(hostname -s)
short_name=${short_name,,}
host_fqdn="$short_name.lab.shaka"
host_principal="host/$host_fqdn@LAB.SHAKA"

if klist -k /etc/krb5.keytab 2>/dev/null | grep -qF " $host_principal"; then
  # This runs on every upgrade, so don't join again.
  echo "Already joined to the domain as $host_fqdn."
else
  if [ ${#short_name} -gt 15 ]; then
    # Active Directory computer names are limited to 15 characters.  adcli
    # would silently truncate a longer name, and two machines whose names start
    # the same way would end up fighting over one computer account.
    echo "ERROR: The host name \"$short_name\" is longer than 15 characters." >&2
    echo "ERROR: Rename this machine, then install this package again." >&2
    exit 1
  fi

  # Prompt for the AD admin password.  If the user has followed our README's
  # instructions, this has already been provided and no prompt is necessary.
  # NOTE: db_input returns a non-zero exit code when skipping a question, so we
  # ignore its return value with "|| true".
  db_input high shaka-lab-gateway-client/active_directory_password || true
  db_go
  db_get shaka-lab-gateway-client/active_directory_password
  active_directory_password="$RET"

  echo "Joining the domain as $host_fqdn."
  if ! printf '%s\n' "$active_directory_password" | adcli join \
      --domain=lab.shaka \
      --domain-realm=LAB.SHAKA \
      --domain-controller=gateway.lab.shaka \
      --login-user=Administrator \
      --stdin-password \
      --host-fqdn="$host_fqdn"; then
    echo "ERROR: Failed to join the domain." >&2
    echo "ERROR: Check the Active Directory password, then install this package again." >&2
    exit 1
  fi
fi

# Nothing else on this machine needs the admin password, so don't keep it.
# Older versions of this package kept it, so clear it even if we didn't just
# join.  Mark the question unseen, so that a later join will ask for it again.
db_set shaka-lab-gateway-client/active_directory_password ""
db_fset shaka-lab-gateway-client/active_directory_password seen false


### SSSD SETUP ###

# Configure sssd, which looks up lab users and checks their passwords using
# this machine's computer account.  The libnss-sss and libpam-sss packages add
# sssd to /etc/nsswitch.conf and PAM on their own.
cat <<EOF >/etc/sssd/sssd.conf
# /etc/sssd/sssd.conf
# sssd configuration file, written by shaka-lab-gateway-client.
# See sssd.conf(5) and sssd-ad(5) for details.

[sssd]
services = nss, pam
domains = lab.shaka

[domain/lab.shaka]
id_provider = ad
ad_domain = lab.shaka
ad_server = gateway.lab.shaka
ad_hostname = $host_fqdn
krb5_realm = LAB.SHAKA

# Only lab users may log in.
access_provider = simple
simple_allow_groups = labusers

# Use the UIDs and GIDs stored in Active Directory, rather than generating
# them, so they match on every machine and on existing home directories.
ldap_id_mapping = false

# Log in as "USER", not "USER@lab.shaka".
use_fully_qualified_names = false

# Use the home directory stored in Active Directory.
ldap_user_home_directory = unixHomeDirectory

# Show changes made on the gateway within a minute.
entry_cache_timeout = 60

# The gateway's DNS zone is static, and doesn't accept updates.
dyndns_update = false
EOF

# sssd refuses to start if other users can read its config.  Newer versions of
# sssd run as the sssd user, and their service grants that group access when
# it starts.
chmod 600 /etc/sssd/sssd.conf

systemctl restart sssd


# Enable the automatic creation of home directories when an AD user logs in.
pam-auth-update --enable mkhomedir


### SSH SETUP ###

# Reload sshd after installing new sshd configs.
if systemctl cat ssh &>/dev/null; then
  # Since Ubuntu 24.04
  systemctl reload-or-restart ssh
else
  # In Ubuntu 22.04 and earlier
  systemctl reload-or-restart sshd
fi


### DNS SETUP ###

# Pick up this package's systemd-resolved config, if resolved is in use.
if systemctl is-active --quiet systemd-resolved; then
  systemctl restart systemd-resolved
fi
