# Asks for a password on the terminal, for "sudo -A".  shaka-lab-update-os
# gives this to Homebrew, which runs as the GUI user, so that its prompts say
# whose password they want.  Otherwise an admin who isn't the GUI user would
# see a bare "Password:" prompt and type in their own.

printf "Password for %s (the user logged in on the GUI): " "$(id -un)" > /dev/tty
read -rs password < /dev/tty
printf "\n" > /dev/tty
printf "%s\n" "$password"
