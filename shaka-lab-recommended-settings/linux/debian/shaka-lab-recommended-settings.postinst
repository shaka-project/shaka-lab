# Post-install script.  Runs as root after package installation.

# Fail on error
set -e

# Reload sshd after installing new sshd configs.
if systemctl cat ssh &>/dev/null; then
  # Since Ubuntu 24.04
  systemctl reload-or-restart ssh
else
  # In Ubuntu 22.04 and earlier
  systemctl reload-or-restart sshd
fi

# Don't let the ssh client warn about lab hosts without post-quantum key
# exchange.  The Windows OpenSSH server in the lab doesn't offer it yet, so
# OpenSSH 10.1 and later warn on every connection to it.  See issue #122.
# Older clients don't know this option, and reject it even inside a Host block
# that doesn't match, which would break every ssh command.  So only write this
# config if the installed client accepts the option.
ssh_client_conf=/etc/ssh/ssh_config.d/shaka-ssh.conf
if ssh -G -o WarnWeakCrypto=no-pq-kex localhost &>/dev/null; then
  cat <<EOF >"$ssh_client_conf"
# ssh client config for the Shaka Lab, written by
# shaka-lab-recommended-settings.  See issue #122.

Host *.lab.shaka shaka-* gateway
    WarnWeakCrypto no-pq-kex
EOF
else
  rm -f "$ssh_client_conf"
fi

# Configure additional apt repositories for third-party browser packages.
# This makes it possible to then install the shaka-lab-browsers metapackage,
# which depends on browser packages from these repos.
#
# Chrome and Edge only need this to bootstrap.  Once installed, each one
# manages its own repo in a .sources file, and its postinst removes the .list
# file and key written here.  If this script wrote them again after that, apt
# would warn that the repo is configured multiple times.

if [ -e /etc/apt/sources.list.d/google-chrome.sources ]; then
  rm -f /etc/apt/sources.list.d/google-chrome.list
else
  # Install the package signing key from Google Chrome.
  curl -L https://dl.google.com/linux/linux_signing_key.pub \
      | gpg --dearmor > /etc/apt/trusted.gpg.d/google-chrome.gpg
  # Configure the package repo that Chrome comes from.
  cat <<EOF >/etc/apt/sources.list.d/google-chrome.list
deb [arch=amd64] http://dl.google.com/linux/chrome/deb/ stable main
EOF
fi

# Get Firefox stable directly from Mozilla's apt repo.  Ubuntu's own "firefox"
# package is a transitional package that installs the snap, which doesn't work
# for our test infrastructure.  The same setup works on Debian.

# Install Mozilla's package signing key.
install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg \
    -o /etc/apt/keyrings/packages.mozilla.org.asc

# Configure the package repo that Firefox comes from.  Older versions of this
# package wrote a one-line .list file instead.
rm -f /etc/apt/sources.list.d/mozilla.list
cat <<EOF >/etc/apt/sources.list.d/mozilla.sources
Types: deb
URIs: https://packages.mozilla.org/apt
Suites: mozilla
Components: main
Signed-By: /etc/apt/keyrings/packages.mozilla.org.asc
EOF

# Ubuntu's transitional package has a version like "1:1snap1", and that epoch
# of 1 makes it sort above every Mozilla version, like "160.0~build1".  A
# priority of 1000 or more is what lets apt "downgrade" from the snap package
# to Mozilla's.  The -1 pin keeps Ubuntu's package from ever being installed
# again, even if Mozilla's repo is briefly unreachable.  Both must be in one
# file: Mozilla's own instructions write them both to this path, so the second
# step overwrites the first.
cat <<EOF >/etc/apt/preferences.d/mozilla
Package: *
Pin: origin packages.mozilla.org
Pin-Priority: 1000

Package: firefox
Pin: release o=Ubuntu
Pin-Priority: -1
EOF

# Make sure that unattended upgrades pull from Mozilla's repo, as well.  Its
# origin field is an opaque, internal-looking name, so match on its site.
cat <<EOF >/etc/apt/apt.conf.d/51unattended-upgrades-firefox
Unattended-Upgrade::Origins-Pattern:: "site=packages.mozilla.org";
EOF

# Older versions of this package used the Mozilla team PPA on Ubuntu, which
# Ubuntu release upgrades disable.  Clean that up.
rm -f /etc/apt/preferences.d/mozillateamppa
rm -f /etc/apt/sources.list.d/mozillateam-ubuntu-ppa-*
rm -f /etc/apt/trusted.gpg.d/mozillateam-ubuntu-ppa.gpg*

# As with Chrome above, Edge manages its own repo once installed.
if [ -e /etc/apt/sources.list.d/microsoft-edge.sources ]; then
  rm -f /etc/apt/sources.list.d/microsoft-edge.list
else
  # Install the package signing key from Microsoft Edge.
  curl -L https://packages.microsoft.com/keys/microsoft.asc \
      | gpg --dearmor > /etc/apt/trusted.gpg.d/microsoft-edge.gpg
  # Configure the package repo that Edge comes from.  This must match the
  # pattern Edge's postinst uses to recognize the repo as its own, which has
  # no trailing slash.  Otherwise, Edge leaves this file in place, but deletes
  # the key it depends on.
  cat <<EOF >/etc/apt/sources.list.d/microsoft-edge.list
deb [arch=amd64] https://packages.microsoft.com/repos/edge stable main
EOF
fi

# Update the package list.
apt update
