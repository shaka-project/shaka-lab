{#
A config file for Samba Active Directory.
-#}
{% set output_path = '/etc/samba/smb.conf' %}
{% set service_reload = 'systemctl restart samba-ad-dc.service' %}
# Global parameters
[global]
	# Only serve on the LAN IP:
	interfaces = {{ lan_ip }}
	bind interfaces only = yes
	netbios name = GATEWAY
	realm = LAB.SHAKA
	server role = active directory domain controller
	server services = s3fs, rpc, nbt, wrepl, ldap, cldap, kdc, drepl, winbindd, ntp_signd, kcc, dnsupdate
	workgroup = LAB
	# Logins on this gateway go through winbind.  Take UIDs and GIDs from
	# uidNumber and gidNumber, to match lab clients, and use plain names like
	# "joeyparrish" and "labadmins" instead of "LAB\joeyparrish".
	idmap_ldb:use rfc2307 = yes
	winbind use default domain = yes
	template homedir = /home/%U
	template shell = /bin/bash

[sysvol]
	path = /var/lib/samba/sysvol
	read only = No

[netlogon]
	path = /var/lib/samba/sysvol/lab.shaka/scripts
	read only = No
