<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Root LaunchDaemon for the loopback HTTP CONNECT proxy.

  It MUST be a root daemon (installed in /Library/LaunchDaemons and loaded into
  the system domain), because root daemons are exempt from macOS Local Network
  Privacy. Running it as a per-user LaunchAgent would re-introduce the gating
  this proxy exists to avoid.

  run-node.sh runs NVM's default Node.js. After a first install, there is no
  Node.js until the shaka-lab-node app installs it, so the proxy fails at
  first, and KeepAlive starts it again until it works.

  Its log goes in /var/log/shaka-lab-node, not with the service logs in
  /opt/shaka-lab-node/logs.  launchd opens it as root, and the GUI user can
  write to that logs folder, so the GUI user could otherwise point it at any
  file.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.shaka-project.shaka-lab-node.local-network-proxy</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/shaka-lab-node/run-node.sh</string>
    <string>/opt/shaka-lab-node/local-network-proxy.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PROXY_PORT</key>
    <string>1080</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/var/log/shaka-lab-node/local-network-proxy.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/shaka-lab-node/local-network-proxy.log</string>
</dict>
</plist>
